#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Get staged files in kestra/flows directory
STAGED_FLOW_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep "^kestra/flows/.*\\.ya\\?ml$" || true)

# If no flow files are staged, skip validation
if [ -z "$STAGED_FLOW_FILES" ]; then
    echo "⏭️  No flow files changed, skipping validation"
    exit 0
fi

# Run validation only on staged files
echo "$STAGED_FLOW_FILES" | xargs bash ./scripts/validate.sh --files
